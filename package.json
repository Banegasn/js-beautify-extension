{
  "name": "js-beautify-extentions",
  "displayName": "js-beautify for VSCode",
  "description": "js-beautify for VSCode",
  "version": "1.0.9",
  "publisher": "banegasn",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "TypeScript",
    "Angular",
    "Angular control flow"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "theme": "light"
  },
  "license": "MIT",
  "main": "./dist/extension",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:html",
    "onLanguage:htm",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onCommand:js-beautify-ext.beautify",
    "onCommand:js-beautify-ext.beautifyFile"
  ],
  "contributes": {
    "commands": [
      {
        "command": "js-beautify-ext.beautify",
        "title": "Beautify selection"
      },
      {
        "command": "js-beautify-ext.beautifyFile",
        "title": "Beautify file"
      }
    ],
    "configuration": {
      "title": "js-beautify for VSCode",
      "properties": {
        "js-beautify-for-vscode.html.templating": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "auto",
              "none",
              "angular",
              "django",
              "erb",
              "php",
              "smarty"
            ],
            "enumDescriptions": [
              "%html.templating.auto%",
              "%html.templating.none%",
              "%html.templating.angular%",
              "%html.templating.django%",
              "%html.templating.erb%",
              "%html.templating.php%",
              "%html.templating.smarty%"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "auto"
          ],
          "description": "%html.templating.desc%"
        },
        "js-beautify-for-vscode.js.templating": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "auto",
              "none",
              "angular",
              "django",
              "erb",
              "php",
              "smarty"
            ],
            "enumDescriptions": [
              "%html.templating.auto%",
              "%html.templating.none%",
              "%html.templating.angular%",
              "%html.templating.django%",
              "%html.templating.erb%",
              "%html.templating.php%",
              "%html.templating.smarty%"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "auto"
          ],
          "description": "%html.templating.desc%"
        },
        "js-beautify-for-vscode.css.templating": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "auto",
              "none",
              "angular",
              "django",
              "erb",
              "php",
              "smarty"
            ],
            "enumDescriptions": [
              "%html.templating.auto%",
              "%html.templating.none%",
              "%html.templating.angular%",
              "%html.templating.django%",
              "%html.templating.erb%",
              "%html.templating.php%",
              "%html.templating.smarty%"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "auto"
          ],
          "description": "%html.templating.desc%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".jsbeautifyrc.json",
        "url": "./schema/beautifyrc.json"
      }
    ]
  },
  "dependencies": {
    "js-beautify": "2.0.3"
  },
  "devDependencies": {
    "@types/js-beautify": "1.14.3",
    "@types/node": "22.20.2",
    "@types/vscode": "1.136.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "patch-package": "8.0.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "postinstall": "patch-package",
    "check": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "test": "node --test test/*.test.cjs",
    "test:vscode": "npm run esbuild-base -- --minify && node test/run-vscode.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Banegasn/js-beautify-extension"
  },
  "bugs": {
    "url": "https://github.com/Banegasn/js-beautify-extension/issues"
  }
}
